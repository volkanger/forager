{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forager",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "workers_dev": true,

  // Landing page (/) and dashboard (/dashboard). Static asset requests are free and don't run the Worker.
  "assets": { "directory": "./public" },

  // One global Durable Object (SQLite-backed, available on the Workers Free plan)
  // holds every quota counter, cooldown, daily stat and encrypted provider key.
  "durable_objects": {
    "bindings": [{ "name": "TRACKER", "class_name": "Tracker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tracker"] }],

  // Workers AI binding. Forager only uses it to discover your account ID for AI Gateway
  // URLs, so this config has nothing account-specific in it.
  "ai": { "binding": "AI" },

  // Daily refresh of OpenRouter's ":free" model list + stats pruning.
  "triggers": { "crons": ["17 3 * * *"] },

  "vars": {
    // AI Gateway name. If it doesn't exist or rejects requests, Forager calls providers directly.
    "AI_GATEWAY_ID": "forager"
    // Optional overrides (defaults in code):
    //   "MAX_ATTEMPTS": "6"             – provider/model attempts per request
    //   "UPSTREAM_TIMEOUT_MS": "30000"  – wait for a provider to start answering (non-streaming)
    //   "UPSTREAM_STREAM_TIMEOUT_MS": "15000" – same, for streaming requests
    //   "GATEWAY_CACHE_TTL": "3600"     – AI Gateway caches identical prompts (saves quota)
    //   "CHAT_HISTORY": "1"             – /chat saves conversations in the Durable Object, scoped to
    //                                     the API key that wrote them. Left out on purpose: without it
    //                                     chats never leave the browser, so your deploy stores nobody's.
  }

  // No secrets are required: open /dashboard after deploying to create your API key.
  // Optional secrets (`wrangler secret put NAME`):
  //   PROXY_API_KEY    – a fixed API key instead of (or besides) dashboard-created keys
  //   KEYSTORE_SECRET  – your own encryption secret for provider keys (16+ chars) instead of a generated one
  //   ADMIN_API_KEY    – separate key for /admin/* (defaults to PROXY_API_KEY)
  //   CF_AIG_TOKEN     – if the AI Gateway has "Authenticated Gateway" turned on
  //   Provider keys (GROQ_API_KEY, GEMINI_API_KEY, …) – usually easier to add in the dashboard
}
